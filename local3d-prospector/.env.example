# Copia in .env e riempi. NIENTE di questo va committato (è in .gitignore).
# Senza chiavi, tutto gira in mock: nessuna rete, nessun invio, nessun addebito.

# --- Ricerca locali ---
GOOGLE_PLACES_API_KEY=

# --- Backend Worker (usato da pipeline/publish per registrare le demo) ---
WORKER_BASE_URL=https://api.tuodominio.it
ADMIN_TOKEN=

# --- Email outreach (Resend) ---
RESEND_API_KEY=
RESEND_FROM=Danilo <danilo@tuodominio-outreach.it>

# --- Pagamenti (Stripe) — impostati come SECRET nel Worker, non qui, se possibile ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Registrar dominio .it (consigliato: Gandi) ---
REGISTRAR_PROVIDER=gandi
REGISTRAR_API_KEY=

# --- Cloudflare (DNS/SSL/deploy) ---
CF_API_TOKEN=
CF_ZONE_ID=
CF_ACCOUNT_ID=

# Forza la modalità mock anche con le chiavi presenti (per i test):
# PROSPECTOR_MODE=mock
