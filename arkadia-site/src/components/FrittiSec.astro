---
// ZONA FRITTI — fondale: patatine che si dilatano, si spezzano e si riuniscono.
import { fritti, categorieMenu } from '../data/contenuti';
const TOP = [fritti[1], fritti[0], fritti[2]]; // Montparnasse (consigliato), Tagliere, Onion Rings
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section id="fritti" class="fritti" data-scene-act="fritti">
  <div class="wrap">
    <p class="occhiello" data-reveal>L'Angolo Fritti</p>
    <h2 class="z-titolo" data-split>Fritti & Sfizi</h2>
    <p class="z-slogan" data-reveal>
      {categorieMenu[1].slogan} I tre più chiesti sono sul bancone della friggitoria — scrollando sfrigolano davanti a te.
    </p>

    <ul class="mlista" data-stagger>
      {
        TOP.map((v) => (
          <li class="mriga">
            <div>
              <h3 class="mnome">
                {v.nome}
                {v.tag?.includes('veg') && <span class="mtag mtag--verde">veg</span>}
                {v.tag?.includes('chef') && <span class="mtag">consigliato</span>}
              </h3>
              {v.desc && <p class="mdesc">{v.desc}</p>}
            </div>
            <span class="mprezzo mono">€ {v.prezzo}</span>
          </li>
        ))
      }
    </ul>
    <a class="z-cta mono" href={`${base}menu#cat-fritti`}>Tutti i fritti sul menu completo →</a>
  </div>
</section>

<style>
  .z-titolo {
    font-size: var(--fs-h2);
    margin-top: 1.25rem;
  }
  .z-cta {
    display: inline-block;
    margin-top: 2.2rem;
    font-size: var(--fs-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--schiuma);
    border-bottom: 1px solid var(--oro);
    padding-bottom: 0.3rem;
  }
  .z-cta:hover { color: var(--oro); }
  .z-slogan {
    margin-top: 1rem;
    max-width: 46ch;
    color: var(--schiuma-soft);
  }
</style>
