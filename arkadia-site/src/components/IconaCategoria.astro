---
// Icona illustrata per ogni categoria del menu — disegnate a mano in palette,
// nessun asset esterno. Uso: <IconaCategoria tipo="birre" />
const { tipo } = Astro.props;
---

<span class:list={['cat-icona', `cat-icona--${tipo}`]} aria-hidden="true">
  {tipo === 'birre' && (
    <svg viewBox="0 0 64 64" fill="none">
      <path d="M20 14 h20 l-2 34 a4 4 0 0 1 -4 3.6 h-8 a4 4 0 0 1 -4 -3.6 z" stroke="var(--schiuma-soft)" stroke-width="2.4" stroke-linejoin="round" />
      <path d="M21.4 24 h17.2 l-1.4 24 a4 4 0 0 1 -4 3.6 h-6.4 a4 4 0 0 1 -4 -3.6 z" fill="var(--ambra)" opacity="0.9" />
      <ellipse cx="30" cy="24" rx="8.6" ry="2.6" fill="var(--schiuma)" />
      <circle cx="26" cy="12.5" r="3.4" fill="var(--schiuma)" opacity="0.95" />
      <circle cx="33" cy="10.5" r="4.2" fill="var(--schiuma)" />
      <path d="M40 22 h5 a4 4 0 0 1 4 4 v8 a4 4 0 0 1 -4 4 h-6" stroke="var(--schiuma-soft)" stroke-width="2.4" />
    </svg>
  )}
  {tipo === 'fritti' && (
    <svg viewBox="0 0 64 64" fill="none">
      <path d="M18 30 l4 -16 M26 29 l2 -18 M34 29 l-1 -17 M42 30 l-4 -15" stroke="var(--oro)" stroke-width="4" stroke-linecap="round" />
      <path d="M14 30 h36 l-4 18 a4 4 0 0 1 -4 3 h-20 a4 4 0 0 1 -4 -3 z" fill="var(--rame)" />
      <path d="M14 30 h36" stroke="var(--schiuma)" stroke-width="2.4" stroke-linecap="round" />
    </svg>
  )}
  {tipo === 'hamburger' && (
    <svg viewBox="0 0 64 64" fill="none">
      <path d="M14 26 a18 12 0 0 1 36 0 z" fill="var(--oro)" />
      <circle cx="26" cy="19" r="1.2" fill="var(--notte)" opacity="0.5" />
      <circle cx="34" cy="17" r="1.2" fill="var(--notte)" opacity="0.5" />
      <rect x="13" y="28" width="38" height="4.5" rx="2.25" fill="var(--luppolo)" />
      <rect x="15" y="34" width="34" height="6" rx="3" fill="var(--rame)" />
      <rect x="13" y="42" width="38" height="7" rx="3.5" fill="var(--oro)" opacity="0.9" />
    </svg>
  )}
  {tipo === 'dessert' && (
    <svg viewBox="0 0 64 64" fill="none">
      <path d="M16 46 L32 18 L48 46 z" fill="var(--schiuma)" opacity="0.92" />
      <path d="M22 36 q3 3 6 0 q3 3 6 0 q3 3 6 0" stroke="var(--rame)" stroke-width="2.4" fill="none" />
      <circle cx="32" cy="14" r="3.2" fill="var(--rame)" />
      <path d="M14 50 h36" stroke="var(--schiuma-soft)" stroke-width="2.4" stroke-linecap="round" />
    </svg>
  )}
  {tipo === 'da-bere' && (
    <svg viewBox="0 0 64 64" fill="none">
      <path d="M24 10 h8 v10 l3 6 v24 a3 3 0 0 1 -3 3 h-8 a3 3 0 0 1 -3 -3 v-24 l3 -6 z" stroke="var(--schiuma-soft)" stroke-width="2.4" stroke-linejoin="round" />
      <path d="M22.5 32 h11 v18 a2.5 2.5 0 0 1 -2.5 2.5 h-6 a2.5 2.5 0 0 1 -2.5 -2.5 z" fill="var(--ambra)" opacity="0.85" />
      <path d="M40 26 h10 l-4 12 v10 M40 26 l4 12 v10 M40 48 h10" stroke="var(--oro)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {tipo === 'caffetteria' && (
    <svg viewBox="0 0 64 64" fill="none">
      <path d="M18 26 h26 v12 a10 10 0 0 1 -10 10 h-6 a10 10 0 0 1 -10 -10 z" stroke="var(--schiuma-soft)" stroke-width="2.4" />
      <path d="M20 28 h22 v9.5 a8 8 0 0 1 -8 8 h-6 a8 8 0 0 1 -8 -8 z" fill="var(--rame)" opacity="0.9" />
      <path d="M44 28 h4 a4.5 4.5 0 0 1 0 9 h-4" stroke="var(--schiuma-soft)" stroke-width="2.4" />
      <path d="M26 20 q-2 -3 0 -6 M32 20 q-2 -3 0 -6 M38 20 q-2 -3 0 -6" stroke="var(--oro)" stroke-width="2.2" stroke-linecap="round" />
    </svg>
  )}
  {tipo === 'cocktail' && (
    <svg viewBox="0 0 64 64" fill="none">
      <path d="M16 14 h32 L32 34 z" stroke="var(--schiuma-soft)" stroke-width="2.4" stroke-linejoin="round" />
      <path d="M21 18.5 h22 L32 31 z" fill="var(--ambra)" opacity="0.9" />
      <path d="M32 34 v14 M24 50 h16" stroke="var(--schiuma-soft)" stroke-width="2.4" stroke-linecap="round" />
      <circle cx="41" cy="13" r="3.6" fill="var(--luppolo)" />
      <path d="M41 13 L36 20" stroke="var(--oro)" stroke-width="2" stroke-linecap="round" />
    </svg>
  )}
  {tipo === 'giochi' && (
    <svg viewBox="0 0 64 64" fill="none">
      <rect x="12" y="12" width="40" height="40" rx="9" stroke="var(--oro)" stroke-width="2.6" />
      <circle cx="24" cy="24" r="3.4" fill="var(--oro)" />
      <circle cx="40" cy="24" r="3.4" fill="var(--oro)" />
      <circle cx="32" cy="32" r="3.4" fill="var(--schiuma)" />
      <circle cx="24" cy="40" r="3.4" fill="var(--rame)" />
      <circle cx="40" cy="40" r="3.4" fill="var(--rame)" />
    </svg>
  )}
</span>

<style>
  .cat-icona {
    display: inline-flex;
    width: clamp(44px, 6vw, 60px);
    height: clamp(44px, 6vw, 60px);
    flex: 0 0 auto;
    filter: drop-shadow(0 4px 14px rgba(232, 176, 75, 0.22));
  }
  .cat-icona svg {
    width: 100%;
    height: 100%;
  }
</style>
