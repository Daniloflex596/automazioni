---
// ATTO VI — Il Brindisi. Climax: calice pieno + CTA. Form fluido che compone
// un messaggio WhatsApp precompilato + tap-to-call. Nessun backend.
import { prenotazione, info, giorniChiusura } from '../data/contenuti';
---

<section id="brindisi" class="brindisi" data-scene-act="brindisi">
  <div class="wrap brindisi-inner">
    <p class="occhiello" data-reveal>{prenotazione.occhiello}</p>
    <h2 class="brindisi-titolo" data-split>{prenotazione.titolo}</h2>
    <p class="brindisi-sub" data-reveal>{prenotazione.sottotitolo}</p>

    <form
      id="form-prenota"
      class="form"
      data-reveal
      data-whatsapp={info.whatsapp}
      data-chiusura={giorniChiusura.join(',')}
      novalidate
    >
      <div class="campo">
        <label for="p-nome">Nome</label>
        <input id="p-nome" name="nome" type="text" autocomplete="name" required />
      </div>
      <div class="campo-row">
        <div class="campo">
          <label for="p-data">Data</label>
          <input id="p-data" name="data" type="date" required />
        </div>
        <div class="campo">
          <label for="p-ora">Ora</label>
          <input id="p-ora" name="ora" type="time" required value="20:00" />
        </div>
        <div class="campo">
          <label for="p-persone">Persone</label>
          <input id="p-persone" name="persone" type="number" min="1" max="30" value="2" required />
        </div>
      </div>
      <div class="campo">
        <label for="p-note">Note <span class="opt">(facoltativo)</span></label>
        <input id="p-note" name="note" type="text" placeholder="Allergie, occasione, tavolo…" />
      </div>

      <div class="azioni">
        <button type="submit" class="btn btn-primary">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
            <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.9 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.8-.6-3.1-1.3-5.1-4.4-5.3-4.6-.1-.2-1.2-1.6-1.2-3.1s.8-2.2 1.1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5.3.6.9 2.1 1 2.2.1.2.1.3 0 .5-.1.2-.2.4-.3.5l-.5.5c-.2.2-.3.3-.1.6.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.6 1.6.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1.3.1 1.7.8 2 .9.3.2.5.2.6.4.1.1.1.7-.1 1.4z"/>
          </svg>
          Prenota su WhatsApp
        </button>
        <a class="btn btn-ghost" href={`tel:${info.telefonoHref}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>
          </svg>
          Chiama {info.telefono}
        </a>
      </div>
      <p class="form-nota mono" id="form-nota" role="status"></p>
    </form>
  </div>
</section>

<script>
  // Compone un messaggio WhatsApp precompilato dai dati del form.
  const form = document.getElementById('form-prenota') as HTMLFormElement | null;
  if (form) {
    const nota = document.getElementById('form-nota');
    const dataInput = form.querySelector('#p-data') as HTMLInputElement | null;

    // Niente prenotazioni nel passato: la data minima è oggi.
    const oggi = new Date();
    const isoOggi = `${oggi.getFullYear()}-${String(oggi.getMonth() + 1).padStart(2, '0')}-${String(oggi.getDate()).padStart(2, '0')}`;
    if (dataInput) dataInput.min = isoOggi;

    // Giorni di chiusura (0=Dom … 6=Sab) letti dal data-attribute.
    const chiusura = (form.dataset.chiusura || '')
      .split(',')
      .filter((s) => s !== '')
      .map(Number);
    const giornoChiuso = (iso: string) => {
      if (!iso) return false;
      const g = new Date(`${iso}T12:00:00`).getDay();
      return chiusura.includes(g);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      // Blocca le date in un giorno di chiusura (es. lunedì).
      if (giornoChiuso(String(dataInput?.value || ''))) {
        if (nota) nota.textContent = 'Quel giorno siamo chiusi — scegli un’altra data 🙏';
        dataInput?.focus();
        return;
      }
      // Fascia oraria di apertura: 19:00–24:00.
      const oraInput = form.querySelector('#p-ora') as HTMLInputElement | null;
      const ora = String(oraInput?.value || '');
      if (ora && ora < '19:00') {
        if (nota) nota.textContent = 'Apriamo alle 19:00 — scegli un orario dalle 19:00 alle 24:00 🍺';
        oraInput?.focus();
        return;
      }
      const d = new FormData(form);
      const dataIt = d.get('data')
        ? new Date(String(d.get('data'))).toLocaleDateString('it-IT', {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
          })
        : '';
      const testo = [
        `Ciao Arkadia! Vorrei prenotare un tavolo.`,
        ``,
        `👤 Nome: ${d.get('nome')}`,
        `📅 Data: ${dataIt}`,
        `🕗 Ora: ${d.get('ora')}`,
        `👥 Persone: ${d.get('persone')}`,
        d.get('note') ? `📝 Note: ${d.get('note')}` : '',
      ]
        .filter(Boolean)
        .join('\n');

      const numero = form.dataset.whatsapp;
      const url = `https://wa.me/${numero}?text=${encodeURIComponent(testo)}`;
      if (nota) nota.textContent = 'Ti apriamo WhatsApp con la richiesta già pronta…';
      window.open(url, '_blank', 'noopener');
    });
  }
</script>

<style>
  .brindisi {
    min-height: 100svh;
    display: flex;
    align-items: center;
  }
  .brindisi-inner {
    max-width: 640px;
  }
  .brindisi-titolo {
    font-size: var(--fs-h1);
    margin-top: 1.5rem;
  }
  .brindisi-sub {
    margin-top: 1.25rem;
    color: var(--schiuma-soft);
    font-size: 1.2rem;
  }
  .form {
    margin-top: 3rem;
    display: grid;
    gap: 1.5rem;
  }
  .campo {
    display: grid;
    gap: 0.5rem;
  }
  .campo-row {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 1rem;
  }
  label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--schiuma-soft);
  }
  .opt {
    opacity: 0.6;
    text-transform: none;
  }
  input {
    background: var(--notte-2);
    border: 1px solid var(--linea);
    border-radius: var(--radius);
    color: var(--schiuma);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.85rem 1rem;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  input::placeholder {
    color: var(--schiuma-soft);
    opacity: 0.5;
  }
  input:focus {
    outline: none;
    border-color: var(--oro);
    box-shadow: 0 0 0 3px var(--oro-glow);
  }
  /* Icona del date/time picker leggibile su fondo scuro */
  input[type='date']::-webkit-calendar-picker-indicator,
  input[type='time']::-webkit-calendar-picker-indicator {
    filter: invert(0.8) sepia(1) saturate(3) hue-rotate(5deg);
    cursor: pointer;
  }
  .azioni {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem 1.5rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    border: 1px solid transparent;
    transition: transform 0.2s var(--ease-out), background 0.3s, color 0.3s;
    flex: 1 1 auto;
  }
  .btn:active {
    transform: scale(0.98);
  }
  .btn-primary {
    background: var(--oro);
    color: var(--notte);
    animation: cta-pulse 2.6s var(--ease-inout) infinite;
  }
  .btn-primary:hover {
    background: var(--schiuma);
    animation-play-state: paused;
  }
  /* Il climax narrativo respira: anello dorato che pulsa attorno al CTA */
  @keyframes cta-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(232, 176, 75, 0.45); }
    55% { box-shadow: 0 0 0 14px rgba(232, 176, 75, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn-primary {
      animation: none;
    }
  }
  .btn-ghost {
    background: transparent;
    color: var(--schiuma);
    border-color: var(--linea);
  }
  .btn-ghost:hover {
    border-color: var(--oro);
    color: var(--oro);
  }
  .form-nota {
    min-height: 1.2em;
    font-size: var(--fs-small);
    color: var(--oro);
  }
  @media (max-width: 560px) {
    .campo-row {
      grid-template-columns: 1fr 1fr;
    }
    .campo-row .campo:first-child {
      grid-column: 1 / -1;
    }
    .btn {
      flex-basis: 100%;
    }
  }
</style>
