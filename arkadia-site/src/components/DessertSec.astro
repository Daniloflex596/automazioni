---
// ZONA DOLCI — fondale: fette di torta orbitanti + cacao che cade.
import { dessert, categorieMenu } from '../data/contenuti';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section id="dessert" class="dessert" data-scene-act="dessert">
  <div class="wrap">
    <p class="occhiello" data-reveal>L'Angolo Dolce</p>
    <h2 class="z-titolo" data-split>Il finale è servito</h2>
    <p class="z-slogan" data-reveal>
      Crêpe, pannacotta col topping che scegli tu e un dolce a sorpresa che cambia ogni sera: alla dolcezza, qui, non c'è mai fine.
    </p>

    <ul class="mlista" data-stagger>
      {
        dessert.map((v) => (
          <li class="mriga">
            <div>
              <h3 class="mnome">{v.nome}</h3>
              {v.desc && <p class="mdesc">{v.desc}</p>}
            </div>
            {v.prezzo && <span class="mprezzo mono">€ {v.prezzo}</span>}
          </li>
        ))
      }
    </ul>
    <a class="z-cta mono" href={`${base}menu#cat-dessert`}>I dolci in carta →</a>
  </div>
</section>

<style>
  .z-titolo {
    font-size: var(--fs-h2);
    margin-top: 1.25rem;
  }
  .z-cta {
    display: inline-block;
    margin-top: 2.2rem;
    font-size: var(--fs-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--schiuma);
    border-bottom: 1px solid var(--oro);
    padding-bottom: 0.3rem;
  }
  .z-cta:hover { color: var(--oro); }
  .z-slogan {
    margin-top: 1rem;
    max-width: 46ch;
    color: var(--schiuma-soft);
  }
</style>
