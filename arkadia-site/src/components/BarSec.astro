---
// ZONA BAR — cocktail, distillati, vini e caffetteria. Fondale: shaker che
// shakera, Martini che ondeggia, tazzina che fuma.
import { cocktail, prezzoCocktail, categorieMenu } from '../data/contenuti';
const TOP = cocktail.slice(0, 3); // i tre più chiesti al bancone
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section id="bar" class="bar" data-scene-act="bar">
  <div class="wrap">
    <p class="occhiello" data-reveal>Il Bar</p>
    <h2 class="z-titolo" data-split>Miscelati come si deve</h2>
    <p class="z-slogan sottoluce" data-reveal>
      Spritz, Negroni e lo Sbagliato che non è mai stato un errore: i tre più chiesti del bancone. In carta: diciotto cocktail a € {prezzoCocktail}, distillati, vini e caffetteria.
    </p>

    <ul class="mlista mlista--cols" data-stagger>
      {
        TOP.map((v) => (
          <li class="mriga">
            <div>
              <h3 class="mnome">{v.nome}</h3>
              <p class="mdesc">{v.desc}</p>
            </div>
            <span class="mprezzo mono">€ {prezzoCocktail}</span>
          </li>
        ))
      }
    </ul>

    <a class="z-cta mono" href={`${base}menu#cat-cocktail`}>Apri la carta del bar →</a>
  </div>
</section>

<style>
  .z-titolo {
    font-size: var(--fs-h2);
    margin-top: 1.25rem;
  }
  .z-cta {
    display: inline-block;
    margin-top: 2.2rem;
    font-size: var(--fs-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--schiuma);
    border-bottom: 1px solid var(--oro);
    padding-bottom: 0.3rem;
  }
  .z-cta:hover { color: var(--oro); }
  .z-slogan {
    margin-top: 1rem;
    max-width: 46ch;
    color: var(--schiuma-soft);
  }
  .mlista--cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 clamp(1.5rem, 4vw, 3rem);
  }
  @media (max-width: 720px) {
    .mlista--cols {
      grid-template-columns: 1fr;
    }
  }
</style>
