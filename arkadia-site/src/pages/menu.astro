---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import Footer from '../components/Footer.astro';
import IconaCategoria from '../components/IconaCategoria.astro';
import {
  birre, birreBottiglia, categorieMenu, info,
  fritti, hamburger, dessert, daBere, caffetteria, cocktail, prezzoCocktail,
  giochiTavolo,
} from '../data/contenuti';

// Base path normalizzato con slash finale (BASE_URL può arrivare senza).
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const tagLabel = { surgelato: 'abbattuto', veg: 'veg', piccante: 'piccante', chef: 'consigliato', noCarne: 'no carne' };

// ---- ICONE 3D per ogni singola voce (spec per icone3d.js) --------------
// Ogni prodotto ha la SUA icona: bicchiere giusto, colore giusto,
// guarnizione giusta. j() serializza la spec nel data-attribute.
const j = (o: object) => JSON.stringify(o);
const icSpina: Record<string, object> = {
  Bionda: { t: 'pinta', c: 'e8c04a' },
  Rossa: { t: 'pinta', c: '96420f' },
  IPA: { t: 'pinta', c: 'd07818' },
  'Birra del Mese': { t: 'pinta', c: 'c89020' },
};
const icBottiglia = (b: { nome: string; stile: string }) => {
  const s = b.stile.toLowerCase();
  if (b.nome === 'Chouffe Red') return { t: 'bottiglia', c: '4a1016', lab: 'c01830' };
  if (s.includes('sidro')) return { t: 'bottiglia', c: '3a5e2a', lab: b.nome.includes('Fragola') ? 'e05070' : 'b8d060' };
  if (s.includes('pils')) return { t: 'bottiglia', c: '3a5e2a', lab: 'f0d060' };
  if (s.includes('lambic')) return { t: 'bottiglia', c: '38160e', lab: 'a01830' };
  if (s.includes('dark')) return { t: 'bottiglia', c: '241208', lab: '6a4a20' };
  if (s.includes('blanche')) return { t: 'bottiglia', c: '8a6a3a', lab: 'f0e6d0' };
  if (s.includes('strong')) return { t: 'bottiglia', c: '38160e', lab: '903020' };
  if (s.includes('i.p.a')) return { t: 'bottiglia', c: '5a3212', lab: 'd07818' };
  if (s.includes('ambrata') || s.includes('bitter')) return { t: 'bottiglia', c: '5a3212', lab: 'b06020' };
  if (s.includes('saison')) return { t: 'bottiglia', c: '5a3212', lab: 'e8d080' };
  if (s.includes('pale')) return { t: 'bottiglia', c: '5a3212', lab: 'c87830' };
  return { t: 'bottiglia', c: '5a3212', lab: 'e8b04b' };
};
const icFritti: Record<string, object> = {
  'Tagliere "Colesterolo"': { t: 'tagliere' },
  'Patatine "Montparnasse"': { t: 'friescup', cheese: 1 },
  'Onion Rings': { t: 'rings' },
  'Nuggets di Pollo': { t: 'nuggets' },
  'Palline di Melanzana': { t: 'palline' },
  'Patatine Cacio e Pepe': { t: 'friescup', pepe: 1 },
  'Patate Stick': { t: 'stick' },
};
const icBurger: Record<string, object> = {
  Brexit: { t: 'burger', pane: 'sesamo', s: ['insalata', 'patty', 'bacon', 'cheddar', 'anelli'] },
  'Hellfire Club': { t: 'burger', pane: 'rustico', s: ['insalata', 'patty', 'stracciatella', 'bomba'] },
  'Cocò': { t: 'burger', pane: 'classico', s: ['insalata', 'cotoletta', 'secchi', 'stracciatella'] },
  Cheeseburger: { t: 'burger', pane: 'brioche', s: ['patty', 'cheddar', 'bacon', 'tomino'] },
  'Insalatona Arkadia': { t: 'bowl' },
  'Peppa Pig': { t: 'salsiccia' },
  'Bimbo Burger': { t: 'burger', pane: 'classico', s: ['insalata', 'patty', 'pomodoro'], mini: 1 },
};
const icDessert: Record<string, object> = {
  'Crêpe alla Nutella': { t: 'crepe' },
  Pannacotta: { t: 'pannacotta' },
  'Dolce del Giorno': { t: 'torta' },
};
const icDistillati: Record<string, object> = {
  Whisky: { t: 'tumbler', c: 'c87828', ice: 1 },
  Rum: { t: 'tumbler', c: '7a3a14' },
  'Grappe / Gin': { t: 'shot', c: 'e8e8e0' },
  Amari: { t: 'shot', c: '6a3a18' },
};
const icVini: Record<string, object> = {
  'Vino Bianco': { t: 'vino', c: 'e8d890' },
  'Vino Rosso': { t: 'vino', c: '7a1626' },
};
const icCaffe: Record<string, object> = {
  'Caffè Invernale': { t: 'mug', c: 'c87828' },
  'Tè / Camomilla / Infusi': { t: 'tisana' },
  'Caffè': { t: 'tazzina' },
};
const icCocktail: Record<string, object> = {
  Spritz: { t: 'goblet', c: 'e06010', slice: 'e89030', ice: 1 },
  Negroni: { t: 'tumbler', c: '8e1420', ice: 1, twist: 1 },
  'Negroni Sbagliato': { t: 'flute', c: 'c84838' },
  Americano: { t: 'highball', c: 'a02030', slice: 'e89030' },
  Boulevardier: { t: 'coupe', c: '7a1620' },
  Mojito: { t: 'highball', c: 'a8d080', mint: 1, lime: 1 },
  'Cuba Libre': { t: 'highball', c: '3a1c0c', lime: 1, straw: 1 },
  'Piña Colada': { t: 'goblet', c: 'f0e0b8', slice: 'f0d060' },
  'Gin Tonic': { t: 'balloon', c: 'dce8e0', lime: 1 },
  'Gin Lemon': { t: 'highball', c: 'f0d060' },
  'Vodka Tonic': { t: 'highball', c: 'e0ecec' },
  'Vodka Lemon': { t: 'highball', c: 'f0d860' },
  'Caipiroska Fragola': { t: 'tumbler', c: 'e04858', frutto: 1, ice: 1 },
  'Sex on the Beach': { t: 'highball', c: 'f09030', c2: 'c02040', straw: 1 },
  'Long Island': { t: 'highball', c: '4a2410', slice: 'f0d060', straw: 1 },
  Alexander: { t: 'coupe', c: '2858c8' },
  'Japanese Ice Tea': { t: 'highball', c: '58b848', lime: 1 },
  Samu: { t: 'tumbler', c: 'f07020' },
};
const menuTitolo = `Menu · ${info.nome} Pub — Birre, hamburger e cocktail a Ciampino`;
const menuDesc =
  'Il menu completo di Arkadia Pub: birre alla spina e in bottiglia (belghe, italiane, artigianali), hamburger da 200gr, fritti, dessert, cocktail e caffetteria.';
---

<Base title={menuTitolo} description={menuDesc}>
  <Preloader />

  <div id="scena" aria-hidden="true">
    <canvas id="scena-canvas"></canvas>
    <svg id="scena-fallback" viewBox="0 0 200 300" preserveAspectRatio="xMidYMid meet" style="display:none">
      <defs>
        <linearGradient id="fbLiquid" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#e8b04b" />
          <stop offset="1" stop-color="#c77b29" />
        </linearGradient>
        <radialGradient id="fbGlow" cx="0.5" cy="0.4" r="0.6">
          <stop offset="0" stop-color="rgba(232,176,75,0.5)" />
          <stop offset="1" stop-color="rgba(14,10,7,0)" />
        </radialGradient>
        <clipPath id="fbClip">
          <path d="M66,58 C66,150 84,203 100,203 C116,203 134,150 134,58 Z" />
        </clipPath>
      </defs>
      <rect x="0" y="0" width="200" height="300" fill="url(#fbGlow)" />
      <g clip-path="url(#fbClip)">
        <rect class="fb-fill" x="60" y="210" width="80" height="0" fill="url(#fbLiquid)" />
      </g>
      <ellipse class="fb-foam" cx="100" cy="210" rx="34" ry="6" fill="#f4e9d0" style="opacity:0" />
      <g fill="none" stroke="rgba(244,233,208,0.55)" stroke-width="2" stroke-linecap="round">
        <path d="M60,55 L140,55" />
        <path d="M64,55 C64,150 82,205 100,205 C118,205 136,150 136,55" />
        <path d="M100,205 L100,258" />
        <path d="M74,272 Q100,256 126,272" />
      </g>
    </svg>
  </div>

  <main id="contenuto" data-whatsapp={info.whatsapp}>
    <!-- Barra di navigazione minimale -->
    <nav class="topbar">
      <a class="topbar-back" href={base}>
        <span aria-hidden="true">←</span> <span>Arkadia</span>
      </a>
      <a class="topbar-cta" href={`${base}#brindisi`}>Prenota</a>
    </nav>

    <!-- Hero del menu -->
    <header class="menu-hero">
      <div class="wrap">
        <p class="occhiello" data-reveal>Il Menu</p>
        <h1 class="menu-h1" data-split>Tutto quello che versiamo e serviamo</h1>
        <p class="menu-lead" data-reveal>
          Dalla spina alla bottiglia, dai panini ai dolci. Ecco cosa trovi da Arkadia.
        </p>
      </div>
    </header>

    <!-- Tab categorie (sticky) -->
    <div class="tabs" id="tabs">
      <div class="wrap tabs-row">
        {
          categorieMenu.map((c) => (
            <a
              class:list={['tab', { 'is-soon': !c.pronta }]}
              href={`#cat-${c.id}`}
              data-tab={c.id}
            >
              {c.nome}
              {!c.pronta && <span class="tab-soon">presto</span>}
            </a>
          ))
        }
      </div>
    </div>

    <!-- ===================== BIRRE ===================== -->
    <section class="cat" id="cat-birre" data-scene-act="spina">
      <div class="wrap">
        <p class="occhiello" data-reveal>Birre</p>
        <div class="cat-head" data-reveal>
          <IconaCategoria tipo="birre" />
          <h2 class="cat-titolo" data-split>Alla spina</h2>
        </div>
        <p class="cat-slogan sottoluce" data-reveal>{birre.slogan}</p>

        <div class="spina-tabella">
          {
            birre.spina.map((b) => (
              <article class="spina-riga" data-reveal>
                <canvas class="micona micona--spina" width="128" height="160" data-icona={j(icSpina[b.nome] ?? { t: 'pinta', c: 'e8c04a' })} aria-hidden="true"></canvas>
                <div class="spina-info">
                  <h3 class="spina-nome">
                    {b.nome}
                    {b.novita && <span class="badge">novità</span>}
                  </h3>
                  <p class="spina-stile mono">{b.stile}</p>
                  <p class="spina-nota">{b.nota}</p>
                </div>
                <dl class="spina-formati mono" aria-label="Formati e prezzi">
                  {birre.formati.map((f, i) =>
                    b.prezzi[i] !== '—' ? (
                      <div>
                        <dt>{f}</dt>
                        <dd>€ {b.prezzi[i]}</dd>
                      </div>
                    ) : null
                  )}
                </dl>
                <button
                  class="ord-btn mono"
                  data-ord={j({ n: `${b.nome} (spina)`, f: birre.formati.map((f, i) => (b.prezzi[i] !== '—' ? { f, p: b.prezzi[i] } : null)).filter(Boolean) })}
                  aria-label={`Aggiungi ${b.nome} all'ordine`}
                >+</button>
              </article>
            ))
          }
        </div>

        <h2 class="cat-titolo cat-titolo--sub" data-split>In bottiglia</h2>
        <p class="cat-slogan sottoluce" data-reveal>
          Belghe, italiane, artigianali e sidri. Diciotto etichette, dal chiaro al forte.
        </p>

        <ul class="bottiglie">
          {
            birreBottiglia.map((b) => (
              <li class="bottiglia" data-reveal>
                <canvas class="micona micona--bott" width="128" height="160" data-icona={j(icBottiglia(b))} aria-hidden="true"></canvas>
                <div class="bottiglia-main">
                  <h3 class="bottiglia-nome">
                    {b.nome}
                    {b.novita && <span class="badge">novità</span>}
                  </h3>
                  <p class="bottiglia-meta mono">
                    {b.stile} · {b.grad} · {b.formato}
                  </p>
                </div>
                <span class="bottiglia-prezzo mono">€ {b.prezzo}</span>
                <button class="ord-btn mono" data-ord={j({ n: b.nome, p: b.prezzo })} aria-label={`Aggiungi ${b.nome} all'ordine`}>+</button>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ===================== FRITTI & SFIZI ===================== -->
    <section class="cat" id="cat-fritti" data-scene-act="tavola">
      <div class="wrap">
        <p class="occhiello" data-reveal>Fritti & Sfizi</p>
        <div class="cat-head" data-reveal>
          <IconaCategoria tipo="fritti" />
          <h2 class="cat-titolo" data-split>Fritti & Sfizi</h2>
        </div>
        <p class="cat-slogan sottoluce" data-reveal>{categorieMenu[1].slogan}</p>
        <ul class="menu-list">
          {fritti.map((v) => (
            <li class="menu-item" data-reveal>
              <canvas class="micona" width="128" height="160" data-icona={j(icFritti[v.nome] ?? { t: 'friescup' })} aria-hidden="true"></canvas>
              <div class="mi-main">
                <h3 class="mi-nome">
                  {v.nome}
                  {v.tag?.map((t) => <span class:list={['tag', `tag--${t}`]}>{tagLabel[t]}</span>)}
                </h3>
                {v.desc && <p class="mi-desc">{v.desc}</p>}
              </div>
              <span class="mi-prezzo mono">€ {v.prezzo}</span>
              <button class="ord-btn mono" data-ord={j({ n: v.nome, p: v.prezzo })} aria-label={`Aggiungi ${v.nome} all'ordine`}>+</button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== HAMBURGER ===================== -->
    <section class="cat" id="cat-hamburger" data-scene-act="tavola">
      <div class="wrap">
        <p class="occhiello" data-reveal>Hamburger</p>
        <div class="cat-head" data-reveal>
          <IconaCategoria tipo="hamburger" />
          <h2 class="cat-titolo" data-split>Hamburger</h2>
        </div>
        <p class="cat-slogan sottoluce" data-reveal>{categorieMenu[2].slogan} — tutti serviti con patatine.</p>
        <ul class="menu-list">
          {hamburger.map((v) => (
            <li class="menu-item" data-reveal>
              <canvas class="micona" width="128" height="160" data-icona={j(icBurger[v.nome] ?? { t: 'burger', pane: 'classico', s: ['insalata', 'patty', 'cheddar'] })} aria-hidden="true"></canvas>
              <div class="mi-main">
                <h3 class="mi-nome">
                  {v.nome}
                  {v.badge && <span class="tag tag--chef">{v.badge}</span>}
                  {v.tag?.map((t) => <span class:list={['tag', `tag--${t}`]}>{tagLabel[t]}</span>)}
                </h3>
                {v.desc && <p class="mi-desc">{v.desc}</p>}
              </div>
              <span class="mi-prezzo mono">€ {v.prezzo}</span>
              <button class="ord-btn mono" data-ord={j({ n: v.nome, p: v.prezzo })} aria-label={`Aggiungi ${v.nome} all'ordine`}>+</button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== DESSERT ===================== -->
    <section class="cat" id="cat-dessert" data-scene-act="tavola">
      <div class="wrap">
        <p class="occhiello" data-reveal>Dessert</p>
        <div class="cat-head" data-reveal>
          <IconaCategoria tipo="dessert" />
          <h2 class="cat-titolo" data-split>Dessert</h2>
        </div>
        <p class="cat-slogan sottoluce" data-reveal>{categorieMenu[3].slogan}</p>
        <ul class="menu-list">
          {dessert.map((v) => (
            <li class="menu-item" data-reveal>
              <canvas class="micona" width="128" height="160" data-icona={j(icDessert[v.nome] ?? { t: 'torta' })} aria-hidden="true"></canvas>
              <div class="mi-main">
                <h3 class="mi-nome">{v.nome}</h3>
                {v.desc && <p class="mi-desc">{v.desc}</p>}
              </div>
              {v.prezzo && <span class="mi-prezzo mono">€ {v.prezzo}</span>}
              {v.prezzo && (
                <button class="ord-btn mono" data-ord={j({ n: v.nome, p: v.prezzo })} aria-label={`Aggiungi ${v.nome} all'ordine`}>+</button>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== DA BERE ===================== -->
    <section class="cat" id="cat-da-bere" data-scene-act="luogo">
      <div class="wrap">
        <p class="occhiello" data-reveal>Da Bere</p>
        <div class="cat-head" data-reveal>
          <IconaCategoria tipo="da-bere" />
          <h2 class="cat-titolo" data-split>Da bere</h2>
        </div>
        <p class="cat-slogan sottoluce" data-reveal>{categorieMenu[4].slogan}</p>

        <h3 class="sub-h mono" data-reveal>Distillati <span>bicchiere · shot</span></h3>
        <ul class="menu-list">
          {daBere.distillati.map((v) => (
            <li class="menu-item" data-reveal>
              <canvas class="micona" width="128" height="160" data-icona={j(icDistillati[v.nome] ?? { t: 'tumbler', c: 'c87828' })} aria-hidden="true"></canvas>
              <div class="mi-main"><h3 class="mi-nome">{v.nome}</h3></div>
              <span class="mi-prezzo mono">€ {v.prezzo} <em>/ {v.shot}</em></span>
              <button class="ord-btn mono" data-ord={j({ n: v.nome, f: [{ f: 'Bicchiere', p: v.prezzo }, { f: 'Shot', p: v.shot }] })} aria-label={`Aggiungi ${v.nome} all'ordine`}>+</button>
            </li>
          ))}
        </ul>

        <h3 class="sub-h mono" data-reveal>Vini <span>calice · bottiglia</span></h3>
        <ul class="menu-list">
          {daBere.vini.map((v) => (
            <li class="menu-item" data-reveal>
              <canvas class="micona" width="128" height="160" data-icona={j(icVini[v.nome] ?? { t: 'vino', c: '7a1626' })} aria-hidden="true"></canvas>
              <div class="mi-main"><h3 class="mi-nome">{v.nome}</h3></div>
              <span class="mi-prezzo mono">€ {v.calice} <em>/ {v.bottiglia}</em></span>
              <button class="ord-btn mono" data-ord={j({ n: v.nome, f: [{ f: 'Calice', p: v.calice }, { f: 'Bottiglia', p: v.bottiglia }] })} aria-label={`Aggiungi ${v.nome} all'ordine`}>+</button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== CAFFETTERIA ===================== -->
    <section class="cat" id="cat-caffetteria" data-scene-act="brindisi">
      <div class="wrap">
        <p class="occhiello" data-reveal>Caffetteria</p>
        <div class="cat-head" data-reveal>
          <IconaCategoria tipo="caffetteria" />
          <h2 class="cat-titolo" data-split>Caffetteria</h2>
        </div>
        <p class="cat-slogan sottoluce" data-reveal>{categorieMenu[5].slogan}</p>
        <ul class="menu-list">
          {caffetteria.map((v) => (
            <li class="menu-item" data-reveal>
              <canvas class="micona" width="128" height="160" data-icona={j(icCaffe[v.nome] ?? { t: 'tazzina' })} aria-hidden="true"></canvas>
              <div class="mi-main">
                <h3 class="mi-nome">{v.nome}</h3>
                {v.desc && <p class="mi-desc">{v.desc}</p>}
              </div>
              <span class="mi-prezzo mono">€ {v.prezzo}</span>
              <button class="ord-btn mono" data-ord={j({ n: v.nome, p: v.prezzo })} aria-label={`Aggiungi ${v.nome} all'ordine`}>+</button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== COCKTAIL ===================== -->
    <section class="cat" id="cat-cocktail" data-scene-act="brindisi">
      <div class="wrap">
        <p class="occhiello" data-reveal>Cocktail</p>
        <div class="cat-head" data-reveal>
          <IconaCategoria tipo="cocktail" />
          <h2 class="cat-titolo" data-split>Cocktail</h2>
        </div>
        <p class="cat-slogan sottoluce" data-reveal>{categorieMenu[6].slogan} — tutti a € {prezzoCocktail}.</p>
        <ul class="menu-list menu-list--cols">
          {cocktail.map((v) => (
            <li class="menu-item" data-reveal>
              <canvas class="micona" width="128" height="160" data-icona={j(icCocktail[v.nome] ?? { t: 'tumbler', c: 'e06010' })} aria-hidden="true"></canvas>
              <div class="mi-main">
                <h3 class="mi-nome">{v.nome}</h3>
                <p class="mi-desc">{v.desc}</p>
              </div>
              <span class="mi-prezzo mono">€ {prezzoCocktail}</span>
              <button class="ord-btn mono" data-ord={j({ n: v.nome, p: prezzoCocktail })} aria-label={`Aggiungi ${v.nome} all'ordine`}>+</button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== SALA GIOCHI ===================== -->
    <section class="cat" id="cat-giochi" data-scene-act="sala">
      <div class="wrap">
        <p class="occhiello" data-reveal>Sala Giochi</p>
        <div class="cat-head" data-reveal>
          <IconaCategoria tipo="giochi" />
          <h2 class="cat-titolo" data-split>La scaffalata dei giochi</h2>
        </div>
        <p class="cat-slogan sottoluce" data-reveal>{categorieMenu[7].slogan}.</p>

        {
          giochiTavolo.length > 0 ? (
            <ul class="menu-list">
              {giochiTavolo.map((g) => (
                <li class="menu-item" data-reveal>
                  <div class="mi-main">
                    <h3 class="mi-nome">{g.nome}</h3>
                    {g.desc && <p class="mi-desc">{g.desc}</p>}
                    {(g.giocatori || g.durata) && (
                      <p class="mi-desc mono gioco-meta">
                        {g.giocatori && <span>{g.giocatori} giocatori</span>}
                        {g.giocatori && g.durata && ' · '}
                        {g.durata && <span>{g.durata}</span>}
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="giochi-nota" data-reveal>
